# Read by every configure the set runs (CONFIG_SITE from nix/package and bootstrap/stage.nix).
# The answers depend on the target alone. Most stand in for AC_RUN_IFELSE checks, which a cross
# build cannot run and autoconf would replace with its worst-case guess.

# hoist's autotools system passes the output and its probe cache when configure got neither
if [ "$prefix" = NONE ] && [ -n "$PKGS_PREFIX" ]; then prefix=$PKGS_PREFIX; fi
if [ "$cache_file" = /dev/null ] && [ -n "$PKGS_CONFIG_CACHE" ]; then cache_file=$PKGS_CONFIG_CACHE; fi
if [ "$sbindir" = '${exec_prefix}/sbin' ]; then sbindir='${exec_prefix}/bin'; fi

# $host is empty natively, where bootstrap/stage.nix may name the libc as site_libc
target_triple=${host:-$(uname -m)-unknown-linux-${site_libc:-gnu}}
target_cpu=${target_triple%%-*}
case $target_triple in
  *-darwin*) target_os=macos ;;
  *-mingw* | *-windows*) target_os=windows ;;
  *) target_os=linux ;;
esac
case $target_triple in
  *-musl*) target_libc=musl ;;
  *) target_libc=glibc ;;
esac

MKDIR_P='mkdir -p'
ac_cv_path_mkdir=mkdir
ac_cv_path_GREP=grep
ac_cv_path_EGREP='grep -E'
ac_cv_path_FGREP='grep -F'
ac_cv_path_SED=sed

gl_cv_cc_float_expbit0='word 0 bit 23'
gl_cv_cc_double_expbit0='word 1 bit 20'
gl_cv_header_float_h_isoc23=no
gl_cv_func_strcasecmp_works=yes

case $target_cpu in
  x86_64 | aarch64 | riscv64 | loongarch64 | powerpc64le)
    ac_cv_sizeof_long_double=16
    ac_cv_type_long_double_wider=yes
    ;;
esac

case $target_cpu in
  x86_64)
    gl_cv_cc_long_double_expbit0='word 2 bit 0'
    ax_cv_have_sse2_ext=yes
    ax_cv_have_sse3_ext=yes
    ax_cv_have_ssse3_ext=yes
    ax_cv_have_sse41_ext=yes
    ax_cv_have_sse42_ext=yes
    ax_cv_have_avx_ext=yes
    ax_cv_have_avx2_ext=yes
    ;;
  aarch64 | riscv64 | loongarch64 | powerpc64le) gl_cv_cc_long_double_expbit0='word 3 bit 16' ;;
esac

case $target_cpu in
  riscv64) ac_cv_unaligned_access=no ;;
  x86_64 | aarch64 | loongarch64 | powerpc64le) ac_cv_unaligned_access=yes ;;
esac

# libtool's file_magic test wants objdump to say pe-x86-64 where llvm-objdump says coff-x86-64, and
# would otherwise reject import libraries such as libiconv.dll.a and build static only
lt_cv_deplibs_check_method=pass_all

if [ "$target_os" = windows ]; then
  gl_cv_func_pthread_mutex_timedlock_in_LIBMULTITHREAD=yes
else
  ac_cv_sizeof_char=1
  ac_cv_sizeof_short=2
  ac_cv_sizeof_int=4
  ac_cv_sizeof_long=8
  ac_cv_sizeof_long_long=8
  ac_cv_sizeof_size_t=8
  ac_cv_sizeof_void_p=8
  ac_cv_sizeof_double=8
  ac_cv_sizeof_wchar_t=4
  ac_cv_c_bigendian=no
  ac_cv_c_char_unsigned=no
  ac_cv_type_uid_t=yes

  ac_cv_func_fork=yes
  ac_cv_func_fork_works=yes
  ac_cv_func_vfork=yes
  ac_cv_func_vfork_works=yes
  ac_cv_func_calloc_0_nonnull=yes
  ac_cv_func_malloc_0_nonnull=yes
  ac_cv_func_realloc_0_nonnull=yes
  gl_cv_func_malloc_0_nonnull=1
  ac_cv_func_chown_works=yes
  ac_cv_func_closedir_void=no
  ac_cv_func_getgroups_works=yes
  ac_cv_func_getpgrp_void=yes
  ac_cv_func_mmap_fixed_mapped=yes
  ac_cv_func_obstack=no
  ac_cv_func_regcomp=yes
  ac_cv_func_strcoll_works=yes
  ac_cv_func_strnlen_working=yes
  ac_cv_func_strtod=yes
  ac_cv_fread_reads_directories=yes
  ac_cv_iconv_omits_bom=no
  ac_cv_printf_positional=yes
  ac_cv_snprintf_returns_bogus=no
  krb5_cv_attr_constructor_destructor=yes,yes

  gl_cv_double_slash_root=no
  gl_cv_struct_dirent_d_ino=yes
  gl_cv_func_chown_ctime_works=yes
  gl_cv_func_chown_slash_works=yes
  gl_cv_func_fchownat_nofollow_works=yes
  gl_cv_func_dup2_works=yes
  gl_cv_func_fcntl_f_dupfd_works=yes
  gl_cv_func_fdopendir_works=yes
  gl_cv_func_fpurge_works=no
  gl_cv_func_fstatat_zero_flag=yes
  gl_cv_func_ftello_works=yes
  gl_cv_func_getcwd_null=yes
  gl_cv_func_getcwd_path_max=yes
  gl_cv_func_link_works=yes
  gl_cv_func_linkat_slash=yes
  gl_cv_func_lstat_dereferences_slashed_symlink=yes
  gl_cv_func_memchr_works=yes
  gl_cv_func_mkdir_trailing_dot_works=yes
  gl_cv_func_mkdir_trailing_slash_works=yes
  gl_cv_func_mkfifo_works=yes
  gl_cv_func_mknod_works=yes
  gl_cv_func_open_slash=yes
  gl_cv_func_perror_works=yes
  gl_cv_func_posix_spawn_works=yes
  gl_cv_func_pthread_sigmask_macro=no
  gl_cv_func_readlink_trailing_slash=yes
  gl_cv_func_readlink_truncate=yes
  gl_cv_func_rename_dest_works=yes
  gl_cv_func_rename_link_works=yes
  gl_cv_func_rename_slash_dst_works=yes
  gl_cv_func_rename_slash_src_works=yes
  gl_cv_func_rmdir_works=yes
  gl_cv_func_select_detects_ebadf=yes
  gl_cv_func_setenv_works=yes
  gl_cv_func_unsetenv_works=yes
  gl_cv_func_sleep_works=yes
  gl_cv_func_stat_file_slash=yes
  gl_cv_func_strndup_works=yes
  gl_cv_func_strstr_works_always=yes
  gl_cv_func_symlink_works=yes
  gl_cv_func_symlinkat_works=yes
  gl_cv_func_ungetc_works=yes
  gl_cv_func_unlink_honors_slashes=yes
  gl_cv_func_working_mkstemp=yes
  gl_cv_func_working_utimes=yes

  gl_cv_func_frexp_works=yes
  gl_cv_func_frexpl_works=yes
  gl_cv_func_isnanl_works=yes
  gl_cv_func_itold_works=yes
  gl_cv_func_ldexpl_works=yes
  gl_cv_func_signbit=yes
  gl_cv_func_signbit_builtins=yes
  gl_cv_func_strtod_works=yes
  gl_cv_func_strtold_works=yes

  gl_cv_func_printf_sizes_c99=yes
  gl_cv_func_printf_long_double=yes
  gl_cv_func_printf_infinite=yes
  gl_cv_func_printf_infinite_long_double=yes
  gl_cv_func_printf_directive_f=yes
  gl_cv_func_printf_directive_lc=yes
  gl_cv_func_printf_directive_ls=yes
  gl_cv_func_printf_directive_n=no
  gl_cv_func_printf_positions=yes
  gl_cv_func_printf_flag_grouping=yes
  gl_cv_func_printf_flag_leftadjust=yes
  gl_cv_func_printf_flag_zero=yes
  gl_cv_func_printf_precision=yes
  gl_cv_func_snprintf_usable=yes
  gl_cv_func_snprintf_directive_n=no
  gl_cv_func_snprintf_retval_c99=yes
  gl_cv_func_snprintf_size1=yes
  gl_cv_func_snprintf_truncation_c99=yes
  gl_cv_func_vsnprintf_usable=yes
  gl_cv_func_vsnprintf_zerosize_c99=yes

  case $target_os in
    macos) answer=no ;;
    *) answer=yes ;;
  esac
  for check in \
    ac_cv_func_working_mktime gl_cv_func_working_mktime gl_cv_func_fflush_stdin \
    gl_cv_func_futimens_works gl_cv_func_utimensat_works gl_cv_func_realpath_works \
    gl_cv_func_posix_spawnp_secure_exec gl_cv_func_printf_directive_a \
    gl_cv_func_printf_directive_b gl_cv_func_printf_enomem gl_cv_func_printf_sizes_c23 \
    gl_cv_func_strerror_0_works gl_cv_func_strstr_linear gl_cv_func_wcwidth_works \
    gl_cv_func_working_getdelim
  do
    eval "$check=$answer"
  done
  unset check answer
  case $target_os in
    macos)
      ac_cv_have_decl_sys_siglist=yes
      lt_cv_sys_max_cmd_len=786432
      lt_cv_apple_cc_single_mod=yes
      ;;
    *)
      ac_cv_have_decl_sys_siglist=no
      lt_cv_sys_max_cmd_len=1572864
      ;;
  esac
fi

if [ "$target_os" = linux ]; then
  ac_cv_c_littleendian=yes
  ac_cv_c_stack_direction=-1
  ac_cv_sizeof_float=4
  ac_cv_sizeof_off_t=8
  ac_cv_sizeof_pid_t=4
  ac_cv_sizeof_ssize_t=8
  ac_cv_sizeof_time_t=8
  ac_cv_file__dev_ptc=no
  ac_cv_file__dev_ptmx=yes
  ac_cv_file__dev_random=yes
  ac_cv_file__dev_urandom=yes
  ac_cv_file__dev_zero=yes
  ac_cv_func_fnmatch_gnu=yes
  ac_cv_func_fnmatch_works=yes
  ac_cv_func_lstat_dereferences_slashed_symlink=yes
  ac_cv_func_lstat_empty_string_bug=no
  ac_cv_func_stat_empty_string_bug=no
  ac_cv_func_memcmp_working=yes
  ac_cv_func_setpgrp_void=yes
  ac_cv_func_setvbuf_reversed=no
  ac_cv_func_utime_null=yes
  gl_cv_C_locale_sans_EILSEQ=yes
  gl_cv_func_getcwd_abort_bug=no
  gl_cv_func_gettimeofday_clobber=no
  gl_cv_func_tzset_clobber=no
  gl_cv_func_stat_dir_slash=yes
  gl_cv_func_strerror_r_works=yes
  gl_cv_func_working_strerror=yes
  gl_cv_func_working_getline=yes
  gl_cv_have_proc_uptime=yes
  lt_cv_shlibpath_overrides_runpath=yes
  if [ "$target_libc" = glibc ]; then
    ac_cv_func_posix_spawn_file_actions_addchdir=yes
    ac_cv_func_posix_spawn_file_actions_addfchdir=yes
  fi
fi

unset target_triple target_cpu target_os target_libc
