{
  "hardening": [
    "format",
    "fortify",
    "noplt",
    "stackclashprotection",
    "stackprotector",
    "strictflexarrays",
    "strictoverflow",
    "trivialautovarinit",
    "zerocallusedregs",
    "libcxxhardening",
    "relro",
    "bindnow",
    "relr",
    "noexecstack",
    "asneeded"
  ],
  "systems": {
    "autotools": [
      {
        "name": "root",
        "type": {
          "kind": "string"
        },
        "default": ".",
        "doc": "directory below the source the project lives in (monorepos, build/cmake)",
        "system": "autotools"
      },
      {
        "name": "flags",
        "type": {
          "kind": "list",
          "element": {
            "kind": "string"
          }
        },
        "default": [],
        "doc": "extra arguments for configure",
        "system": "autotools"
      },
      {
        "name": "makeFlags",
        "type": {
          "kind": "list",
          "element": {
            "kind": "string"
          }
        },
        "default": [],
        "doc": "arguments for every make invocation (build, test, install)",
        "system": "autotools"
      },
      {
        "name": "installFlags",
        "type": {
          "kind": "list",
          "element": {
            "kind": "string"
          }
        },
        "default": [],
        "doc": "arguments for `make install` only",
        "system": "autotools"
      },
      {
        "name": "buildTarget",
        "type": {
          "kind": "list",
          "element": {
            "kind": "string"
          }
        },
        "default": [],
        "doc": "make goals for build (empty means the makefile's default goal)",
        "system": "autotools"
      },
      {
        "name": "testTarget",
        "type": {
          "kind": "list",
          "element": {
            "kind": "string"
          }
        },
        "default": [
          "check"
        ],
        "doc": "make goals for test",
        "system": "autotools"
      },
      {
        "name": "installTarget",
        "type": {
          "kind": "list",
          "element": {
            "kind": "string"
          }
        },
        "default": [
          "install"
        ],
        "doc": "make goals for install",
        "system": "autotools"
      },
      {
        "name": "configureScript",
        "type": {
          "kind": "string"
