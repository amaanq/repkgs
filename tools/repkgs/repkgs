#!/usr/bin/env nu
# One entry point for working on the set. Every subcommand is a thin wrapper that ends in
# nix-build, nix, uptrack, jigd or treefmt: `repkgs <cmd> --help` shows what it runs.
use nix.nu *
use dev.nu *

def main []: nothing -> nothing { help main }

# build packages through the compile cache
def "main build" [
  --for: string # platform, e.g. aarch64-linux, x86_64-windows
  --seed: path
  --rust-toolchain: path
  ...attrs: string # package attributes (jq, jq.tests)
]: nothing -> nothing {
  if ($attrs | is-empty) { fail "repkgs build <attr>…, or nix-build -A ci for the whole set" }
  ^rom --platform nix build ...($attrs | each {|attr| $"($attr)^out" }) -- --file (root) ...$XP --quiet --no-link --print-out-paths ...(cache-args) ...(platform-arg $for) ...(seed-arg $seed) ...(rust-toolchain-arg $rust_toolchain)
  exit $env.LAST_EXIT_CODE
}

# build <pkg>.tests (tests.separate packages), or the package itself when it tests in-build.
# No attrs: the builder's own tests (tests/builder), run those after editing builder/
def "main test" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  ...attrs: string
]: nothing -> nothing {
  if ($attrs | is-empty) {
    ^rom --platform nix build .^out -- --file $"(root)/tests/builder" ...$XP --quiet --no-link --print-out-paths ...(cache-args) ...(platform-arg $for) ...(seed-arg $seed) ...(rust-toolchain-arg $rust_toolchain)
    exit $env.LAST_EXIT_CODE
  }
  let targets = ($attrs | each {|a| if (eval $"(pkg-expr $a $for $seed $rust_toolchain) ? tests") { $"($a).tests" } else { $a } })
  main build --for=$for --seed=$seed --rust-toolchain=$rust_toolchain ...$targets
}

# the build log of a package's derivation
def "main log" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  attr: string
]: nothing -> nothing {
  let d = (drv $attr $for $seed $rust_toolchain)
  let r = (^nix ...$XP log $d | complete)
  if $r.exit_code != 0 { fail $"no local log for ($d): built elsewhere or substituted, `repkgs build` it here first" }
  print $r.stdout
}

# packages a platform supports, or the ones it does not and why
def "main list" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  --unsupported # show what `supported` filters out, with the reason
  --json (-j) # machine-readable
]: nothing -> any {
  let set = (set-expr $for $seed $rust_toolchain)
  let rows = (if $unsupported {
    eval $"let s = ($set); in map \(n: { name = n; reason = s.${n}.unsupportedReason; }\) \(builtins.filter \(n: !s.${n}.supported\) \(builtins.attrNames s\)\)"
  } else {
    eval $"let s = ($set); in builtins.filter \(n: s.${n}.supported\) \(builtins.attrNames s\)"
  })
  if $json { $rows | to json } else if $unsupported { $rows } else { $rows | wrap name }
}

# version, platform support, build systems and features of one package without building it
def "main info" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  --json (-j) # machine-readable: the full record
  attr: string
]: nothing -> any {
  let p = (eval $"let p = (pkg-expr $attr $for $seed $rust_toolchain); in { name = p.pname; version = p.version or null; platform = p.platform; supported = p.supported; reason = p.unsupportedReason; uses = p.args.uses or []; features = builtins.mapAttrs \(n: d: d // { value = p.features.${n}; }\) \(p.args.features or {}\); }")
  if $json { return ($p | to json) }
  print ({name: $p.name, version: $p.version, platform: $p.platform, uses: ($p.uses | str join " ")}
    | merge (if $p.supported { {} } else { {unsupported: $p.reason} }))
  if ($p.features | is-not-empty) {
    print ($p.features | transpose feature f | each {|r| {feature: $r.feature, value: ($r.f.value | to nuon), values: ($r.f.values? | default [] | str join " | "), doc: ($r.f.doc? | default "")} } | table -i false)
  }
}

# The Nix option declarations provide defaults and validation for jib's typed inputs.
def "main options" [
  --json (-j) # machine-readable: { <system> = { <option> = { type, default, doc } } }
  ...systems: string # build systems, default all
]: nothing -> any {
  let all = (eval $"\(import (root)/nix/options.nix {}\).options")
  let names = (if ($systems | is-empty) { $all | columns } else { $systems | uniq })
  let unknown = ($names | where $it not-in ($all | columns))
  if ($unknown | is-not-empty) { fail $"no build system '($unknown | str join ' ')', have: ($all | columns | str join ' ')" }
  if $json { return ($all | select ...$names | to json) }
  for bs in $names {
    print $"## ($bs)\n"
    print ($all | get $bs | transpose option v | each {|r| {option: $"`($bs).($r.option)`", type: ($r.v.type | str join " | " | str replace "set | string" package), default: (if ($r.v.type | str join " " | str contains "set string") { "lock file" } else { $r.v.default | to nuon }), meaning: $r.v.doc} } | to md --pretty)
    print ""
  }
}

# a new package directory with package.toml from a purl and url template (uptrack init)
def "main new" [
  name: string # attribute name
  purl: string # pkg:github/owner/repo, pkg:pypi/name, pkg:gnu/name, …
  url: string # source url with {version} {tag} {major} {minor}
]: nothing -> nothing {
  let dir = $"(root)/pkgs/($name | str substring 0..<2)/($name)"
  if ($dir | path exists) { fail $"($dir) exists" }
  try { with-env { UPTRACK_ROOT: (root) } { ^uptrack init $dir $purl $url } } catch {
    rm -rf $dir
    fail $"uptrack init failed for ($purl), nothing written"
  }
  if not ($"($dir)/package.nix" | path exists) {
    $"{\n  package,\n  pkgs,\n}:\npackage {\n  name = \"($name)\";\n  uses = [ \"autotools\" ];\n}\n" | save $"($dir)/package.nix"
  }
  print -e $"($dir): edit package.nix, then repkgs build ($name)"
}

# versions and lock tables: uptrack check | apply | lock | verify | rehash | list. The
# development shell supplies uptrack (nix/uptrack.nix), outside it `uptrack` must be on PATH
def --wrapped "main update" [...args: string]: nothing -> nothing {
  with-env { UPTRACK_ROOT: (root) } { ^uptrack ...$args }
}

# rebuild and compare against the store (nix-build --check)
def "main repro" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  ...attrs: string # default: zlib xz pcre2 jq sqlite ncurses
]: nothing -> table {
  let attrs = (if ($attrs | is-empty) { [zlib xz pcre2 jq sqlite ncurses] } else { $attrs })
  $attrs | each {|a|
    let build = (^nix-build (root) ...$XP -A $a --no-out-link ...(cache-args) ...(platform-arg $for) ...(seed-arg $seed) ...(rust-toolchain-arg $rust_toolchain) | complete)
    if $build.exit_code != 0 { return {attr: $a, status: build-failed} }
    let resolved = (^nix-store --query --deriver ($build.stdout | str trim) | str trim)
    # --check compiles for real: no cache
    let check = (^nix-build $resolved ...$XP --no-out-link --check --keep-failed | complete)
    {attr: $a, status: (if $check.exit_code == 0 { "reproducible" } else if $check.stderr =~ "may not be deterministic|differs" { "DIFFERS" } else { "check-failed" })}
  }
}

# the compile cache daemon: start | stop | status
def "main cache" [
  action: string # start, stop or status
  --size: int = 50 # GiB before whole packs are evicted (start)
  --daemon: path
  --seed: path
  --rust-toolchain: path
]: nothing -> nothing {
  let dir = (jigd-dir)
  let sock = $"($dir)/socket"
  let pidfile = $"($dir)/pid"
  match $action {
    "start" => {
      if $size < 0 { fail "cache size must be nonnegative" }
      if (is-socket $sock) { print -e $"jigd already serving ($sock)"; return }
      let executable = (if $daemon == null {
        let build = (^nix-build (root) ...$XP -A jigd --no-out-link ...(seed-arg $seed) ...(rust-toolchain-arg $rust_toolchain) err> /dev/stderr | complete)
        if $build.exit_code != 0 { fail "could not build jigd" }
        $build.stdout | str trim | path join bin jigd
      } else { $daemon | path expand --strict })
      mkdir $dir
      let log = $"($dir)/log"
      let pid = (^setsid --fork sh -c 'printf "%s\n" "$$"; JIGD_SIZE="$1" exec "$2" "$3" >"$4" 2>&1 < /dev/null' -- $size $executable $sock $log | str trim | into int)
      let deadline = (date now) + 5sec
      loop {
        let process = (^kill -0 $pid | complete)
        if $process.exit_code != 0 {
          rm -f $pidfile
          fail $"jigd failed to start\n(open --raw $log)"
        }
        if (is-socket $sock) {
          $pid | into string | save -f $pidfile
          print -e $"jigd pid ($pid), socket ($sock), log ($log)"
          break
        }
        if (date now) >= $deadline {
          ^kill $pid
          rm -f $pidfile
          fail $"jigd did not open ($sock)\n(open --raw $log)"
        }
        sleep 25ms
      }
    }
    "stop" => {
      if not ($pidfile | path exists) { return }
      let stopped = (^kill (open --raw $pidfile | str trim) | complete)
      if $stopped.exit_code != 0 { fail $stopped.stderr }
      let deadline = (date now) + 5sec
      while (is-socket $sock) {
        if (date now) >= $deadline { fail $"jigd has not stopped, see ($dir)/log" }
        sleep 25ms
      }
      rm -f $pidfile
    }
    "status" => {
      let s = (jigd-socket)
      if $s == null { print "jigd: not running"; return }
      print $"jigd: ($s)"
      if ($"($dir)/log" | path exists) { ^tail -n 3 $"($dir)/log" }
    }
    _ => { fail "repkgs cache start|stop|status" }
  }
}

# build seed nars on this machine and upload them (pkgs/se/seed/upload.nu)
def --wrapped "main seed" [...args: string]: nothing -> nothing {
  ^$"(root)/pkgs/se/seed/upload.nu" ...$args
}

# cross build <pkg> for cpus upstream has no binaries for and upload it as <pkg>-bootstrap's source (tools/upload-bootstrap.nu)
def --wrapped "main bootstrap" [...args: string]: nothing -> nothing {
  ^$"(root)/tools/upload-bootstrap.nu" ...$args
}

# format and lint the tree (treefmt)
def --wrapped "main fmt" [...args: string]: nothing -> nothing {
  cd (root)
  ^treefmt ...$args
}
