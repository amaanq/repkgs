#!/usr/bin/env nu
# The one command for working on the set. Each subcommand ends in nix-build, nix, uptrack, jigd or
# nuff, and `repkgs <command> --help` says which.
use nix.nu *
use dev.nu *

def main []: nothing -> nothing { help main }

def built [attrs: list<string>, platform, seed, toolchain, --file: string]: nothing -> nothing {
  let targets = ($attrs | each {|attr| $"($attr)^out" })
  let flags = [--quiet --no-link --print-out-paths ...(cache-args) ...(platform-arg $platform) ...(seed-arg $seed) ...(rust-toolchain-arg $toolchain)]
  # a failed build exits with nix's status
  try { ^rom --platform nix build ...$targets -- --file ($file | default (root)) ...$FEATURES ...$flags } catch {|failure| exit ($failure.exit_code? | default 1) }
}

# build packages with the compile cache
def "main build" [
  --for: string # platform, aarch64-linux or x86_64-windows for instance
  --seed: path
  --rust-toolchain: path
  ...attrs: string # attributes, jq or jq.tests
]: nothing -> nothing {
  if ($attrs | is-empty) { fail "repkgs build <attr>…, or nix-build nix/checks.nix for everything" }
  built $attrs $for $seed $rust_toolchain
}

# build <pkg>.tests for packages that test separately and the package for those that test in its
# own build. Without attrs, the builder's tests in tests/builder, which follow any builder/ edit
def "main test" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  ...attrs: string
]: nothing -> nothing {
  if ($attrs | is-empty) {
    built [.] $for $seed $rust_toolchain --file $"(root)/tests/builder"
    return
  }
  let targets = ($attrs | each {|attr|
    let separate = (eval $"(pkg-expr $attr $for $seed $rust_toolchain) ? tests")
    if $separate { $"($attr).tests" } else { $attr }
  })
  built $targets $for $seed $rust_toolchain
}

# print the build log of a package's derivation
def "main log" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  attr: string
]: nothing -> nothing {
  let derivation = (drv $attr $for $seed $rust_toolchain)
  let log = (^nix ...$FEATURES log $derivation | complete)
  if $log.exit_code != 0 { fail $"no local log for ($derivation), it was built elsewhere or substituted, so `repkgs build` it here first" }
  print $log.stdout
}

# the packages a platform supports, or with --unsupported the others and why
def "main list" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  --unsupported # what `supported` leaves out, with the reason
  --json (-j) # machine-readable
]: nothing -> any {
  let set = (set-expr $for $seed $rust_toolchain)
  if $unsupported {
    let refused = (eval $"let s = ($set); in map \(n: { name = n; reason = s.${n}.unsupportedReason; }\) \(builtins.filter \(n: !s.${n}.supported\) \(builtins.attrNames s\)\)")
    return (if $json { $refused | to json } else { $refused })
  }
  let names = (eval $"let s = ($set); in builtins.filter \(n: s.${n}.supported\) \(builtins.attrNames s\)")
  if $json { $names | to json } else { $names | wrap name }
}

# one package's version, platform support, build systems and features, without building it
def "main info" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  --json (-j) # machine-readable, the whole record
  attr: string
]: nothing -> any {
  let fields = "{ name = p.pname; version = p.version or null; platform = p.platform; supported = p.supported; reason = p.unsupportedReason; uses = p.args.uses or []; features = builtins.mapAttrs (n: d: d // { value = p.features.${n}; }) (p.args.features or {}); }"
  let package = (eval $"let p = (pkg-expr $attr $for $seed $rust_toolchain); in ($fields)")
  if $json { return ($package | to json) }

  let summary = {name: $package.name, version: $package.version, platform: $package.platform, uses: ($package.uses | str join " ")}
  print ($summary | merge (if $package.supported { {} } else { {unsupported: $package.reason} }))
  if ($package.features | is-empty) { return }
  print ($package.features | transpose feature spec | each {|row|
    {feature: $row.feature, value: ($row.spec.value | to nuon), values: ($row.spec.values? | default [] | str join " | "), doc: ($row.spec.doc? | default "")}
  } | table -i false)
}

# the options each build system takes, with their defaults and meaning
def "main options" [
  --json (-j) # machine-readable, { <system> = { <option> = { type, default, doc } } }
  ...systems: string # build systems, all by default
]: nothing -> any {
  let every = (eval $"\(import (root)/nix/options.nix {}\).options")
  let known = ($every | columns)
  let wanted = (if ($systems | is-empty) { $known } else { $systems | uniq })
  let unknown = ($wanted | where $it not-in $known)
  if ($unknown | is-not-empty) { fail $"no build system '($unknown | str join ' ')', have: ($known | str join ' ')" }
  if $json { return ($every | select ...$wanted | to json) }

  for system in $wanted {
    print $"## ($system)\n"
    let rows = ($every | get $system | transpose option spec | each {|row|
      let kinds = ($row.spec.type | str join " ")
      {
        option: $"`($system).($row.option)`"
        type: ($row.spec.type | str join " | " | str replace "set | string" package)
        default: (if ($kinds | str contains "set string") { "lock file" } else { $row.spec.default | to nuon })
        meaning: $row.spec.doc
      }
    })
    print ($rows | to md --pretty)
    print ""
  }
}

# start a package directory whose recipe.toml comes from a purl and a url template (uptrack init)
def "main new" [
  name: string # attribute name
  purl: string # pkg:github/owner/repo, pkg:pypi/name, pkg:gnu/name and the like
  url: string # source url with {version} {tag} {major} {minor}
]: nothing -> nothing {
  let dir = $"(root)/pkgs/($name | str substring 0..<2)/($name)"
  if ($dir | path exists) { fail $"($dir) exists" }
  try { with-env {UPTRACK_ROOT: (root)} { ^uptrack init $dir $purl $url } } catch {
    rm -rf $dir
    fail $"uptrack init failed for ($purl), nothing written"
  }
  let manifest = $"($dir)/recipe.toml"
  if not ((open $manifest) | columns | any {|table| $table == build }) {
    "\n[build]\nsystems = [ \"autotools\" ]\n" | save --append $manifest
  }
  print -e $"($dir): fill in the [build] table, then repkgs build ($name)"
}

# uptrack check, apply, lock, verify, rehash or list over the tree. The development shell has
# uptrack (nix/uptrack.nix), elsewhere it must be on PATH
def --wrapped "main update" [...args: string]: nothing -> nothing {
  with-env {UPTRACK_ROOT: (root)} { ^uptrack ...$args }
}

# build packages again and compare with the store (nix-build --check)
def "main repro" [
  --for: string # platform
  --seed: path
  --rust-toolchain: path
  ...attrs: string # zlib xz pcre2 jq sqlite ncurses by default
]: nothing -> table {
  let attrs = (if ($attrs | is-empty) { [zlib xz pcre2 jq sqlite ncurses] } else { $attrs })
  $attrs | each {|attr|
    let build = (^nix-build (root) ...$FEATURES -A $attr --no-out-link ...(cache-args) ...(platform-arg $for) ...(seed-arg $seed) ...(rust-toolchain-arg $rust_toolchain) | complete)
    if $build.exit_code != 0 { return {attr: $attr, status: build-failed} }
    let derivation = (^nix-store --query --deriver ($build.stdout | str trim) | str trim)
    # --check really compiles, so the cache stays out of it
    let check = (^nix-build $derivation ...$FEATURES --no-out-link --check --keep-failed | complete)
    let status = if $check.exit_code == 0 { "reproducible" } else if $check.stderr =~ "may not be deterministic|differs" { "DIFFERS" } else { "check-failed" }
    {attr: $attr, status: $status}
  }
}

def wait-for [deadline: datetime, ready: closure, late: closure]: nothing -> nothing {
  loop {
    if (do $ready) { return }
    if (date now) >= $deadline { do $late }
    sleep 25ms
  }
}

# start, stop or report on the compile cache daemon
def "main cache" [
  action: string # start, stop or status
  --size: int = 50 # GiB kept before whole packs are evicted, for start
  --daemon: path
  --seed: path
  --rust-toolchain: path
]: nothing -> nothing {
  let dir = (jigd-dir)
  let socket = $"($dir)/socket"
  let pidfile = $"($dir)/pid"
  let log = $"($dir)/log"
  match $action {
    "start" => {
      if $size < 0 { fail "cache size must be nonnegative" }
      if (is-socket $socket) {
        print -e $"jigd already serving ($socket)"
        return
      }
      let program = if $daemon != null { $daemon | path expand --strict } else {
        let build = (^nix-build (root) ...$FEATURES -A jigd --no-out-link ...(seed-arg $seed) ...(rust-toolchain-arg $rust_toolchain) err> /dev/stderr | complete)
        if $build.exit_code != 0 { fail "could not build jigd" }
        $build.stdout | str trim | path join bin jigd
      }
      mkdir $dir
      let pid = (^setsid --fork sh -c 'printf "%s\n" "$$"; JIGD_SIZE="$1" exec "$2" "$3" >"$4" 2>&1 < /dev/null' -- $size $program $socket $log | str trim | into int)
      wait-for ((date now) + 5sec) {||
        if (^kill -0 $pid | complete).exit_code != 0 {
          rm -f $pidfile
          fail $"jigd failed to start\n(open --raw $log)"
        }
        is-socket $socket
      } {||
        ^kill $pid
        rm -f $pidfile
        fail $"jigd did not open ($socket)\n(open --raw $log)"
      }
      $pid | into string | save -f $pidfile
      print -e $"jigd pid ($pid), socket ($socket), log ($log)"
    }
    "stop" => {
      if not ($pidfile | path exists) { return }
      let stopped = (^kill (open --raw $pidfile | str trim) | complete)
      if $stopped.exit_code != 0 { fail $stopped.stderr }
      wait-for ((date now) + 5sec) {|| not (is-socket $socket) } {|| fail $"jigd has not stopped, see ($log)" }
      rm -f $pidfile
    }
    "status" => {
      let serving = (jigd-socket)
      if $serving == null {
        print "jigd: not running"
        return
      }
      print $"jigd: ($serving)"
      if ($log | path exists) { ^tail -n 3 $log }
    }
    _ => { fail "repkgs cache start|stop|status" }
  }
}

# build the seed nars here and upload them (pkgs/se/seed/upload.nu)
def --wrapped "main seed" [...args: string]: nothing -> nothing {
  ^$"(root)/pkgs/se/seed/upload.nu" ...$args
}

# cross build <pkg> for cpus upstream ships no binaries for and upload it as the source of
# <pkg>-bootstrap (tools/upload-bootstrap.nu)
def --wrapped "main bootstrap" [...args: string]: nothing -> nothing {
  ^$"(root)/tools/upload-bootstrap.nu" ...$args
}

# format and lint the tree with nuff (nuff.toml)
def --wrapped "main fmt" [...args: string]: nothing -> nothing {
  cd (root)
  ^nuff ...$args
}
