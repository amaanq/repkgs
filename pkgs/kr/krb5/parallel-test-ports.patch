     return await_daemon_exit(proc)
 
 
+_port_slot = None
+
+
+def _private_port(port):
+    # Parallel test scripts would all listen on the fixed 61000 and 62000 bases, so each script
+    # holds a lock on a slot and maps both bases into its own block below the ephemeral range.
+    global _port_slot
+    if _port_slot is None:
+        tmp = os.environ.get('TMPDIR', '/tmp')
+        for slot in range(110):
+            lock = open(os.path.join(tmp, 'k5test-ports-%d' % slot), 'w')
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except OSError:
+                lock.close()
+                continue
+            _port_slot = (slot, lock)
+            break
+        else:
+            fail('no free k5test port slot')
+    if port < 61000:
+        return port
+    offset = port - 61000 if port < 62000 else 100 + port - 62000
+    return 10000 + 200 * _port_slot[0] + offset
+
