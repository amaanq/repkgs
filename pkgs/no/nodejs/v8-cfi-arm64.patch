Build V8 with branch target landing pads on arm64, so its generated code runs
where the rest of the process is linked with BTI enforced.

diff -ruN a/common.gypi b/common.gypi
--- a/common.gypi
+++ b/common.gypi
@@ -88,6 +88,7 @@
     'v8_enable_pointer_compression_shared_cage%': 0,
     'v8_enable_external_code_space%': 0,
     'v8_enable_sandbox%': 0,
+    'v8_control_flow_integrity%': 0,
     'v8_enable_v8_checks%': 0,
     'v8_enable_zone_compression%': 0,
     'v8_use_perfetto': 0,
@@ -527,6 +528,9 @@
       ['v8_enable_sandbox == 1', {
         'defines': ['V8_ENABLE_SANDBOX',],
       }],
+      ['v8_control_flow_integrity == 1', {
+        'defines': ['V8_ENABLE_CONTROL_FLOW_INTEGRITY',],
+      }],
       ['v8_enable_external_code_space == 1', {
         'defines': ['V8_EXTERNAL_CODE_SPACE',],
       }],
diff -ruN a/configure.py b/configure.py
--- a/configure.py
+++ b/configure.py
@@ -2014,6 +2014,8 @@
   o['variables']['v8_enable_hugepage'] = 1 if options.v8_enable_hugepage else 0
   if options.v8_enable_short_builtin_calls or o['variables']['target_arch'] == 'x64':
     o['variables']['v8_enable_short_builtin_calls'] = 1
+  if o['variables']['target_arch'] == 'arm64':
+    o['variables']['v8_control_flow_integrity'] = 1
   if options.v8_enable_snapshot_compression:
     o['variables']['v8_enable_snapshot_compression'] = 1
   if all(opt in sys.argv for opt in ['--v8-enable-object-print', '--v8-disable-object-print']):
