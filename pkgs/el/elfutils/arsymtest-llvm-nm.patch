llvm-nm reads -s as --segment and starts its armap with "Archive map" on the
first line, which a 1,/re/ range never closes on.

--- a/tests/run-arsymtest.sh
+++ b/tests/run-arsymtest.sh
@@ -28,8 +28,8 @@
 result=77
 if test -f $lib; then
     # Generate list using `nm' we check against.
-    ${NM} -s $lib |
-    sed -e '1,/^Arch/d' -e '/^$/,$d' |
+    ${NM} --print-armap $lib |
+    sed -e '0,/^Arch/d' -e '/^$/,$d' |
     sort > $okfile
 
     # Now run our program using libelf.
