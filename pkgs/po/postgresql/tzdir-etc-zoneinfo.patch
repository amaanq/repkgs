diff -ruN a/src/timezone/pgtz.c b/src/timezone/pgtz.c
--- a/src/timezone/pgtz.c
+++ b/src/timezone/pgtz.c
@@ -15,6 +15,7 @@
 #include <ctype.h>
 #include <fcntl.h>
 #include <time.h>
