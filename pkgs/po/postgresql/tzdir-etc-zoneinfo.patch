diff -ruN a/src/timezone/pgtz.c b/src/timezone/pgtz.c
--- a/src/timezone/pgtz.c
+++ b/src/timezone/pgtz.c
@@ -15,6 +15,8 @@
 #include <ctype.h>
 #include <fcntl.h>
 #include <time.h>
+#include <stdlib.h>
+#include <unistd.h>
 
 #include "common/file_utils.h"
 #include "datatype/timestamp.h"
@@ -57,7 +59,17 @@
 	return tzdir;
 #else
 	/* we're configured to use system's timezone database */
-	return SYSTEMTZDIR;
+	static const char *tzdir = NULL;
+
+	if (tzdir == NULL)
+	{
+		const char *given = getenv("TZDIR");
+
+		tzdir = given && *given ? given
+			: access(SYSTEMTZDIR, F_OK) != 0 && access("/etc/zoneinfo", F_OK) == 0 ? "/etc/zoneinfo"
+			: SYSTEMTZDIR;
+	}
+	return tzdir;
 #endif
 }
 
