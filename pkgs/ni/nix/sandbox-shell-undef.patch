Without a sandbox shell HAVE_EMBEDDED_SANDBOX_SHELL stays undefined, and the #if testing it
in linux-derivation-builder.cc fails under -Werror=undef.

--- a/src/libstore/meson.build
+++ b/src/libstore/meson.build
@@ -184,6 +184,8 @@
 elif busybox.found()
   configdata_priv.set_quoted('SANDBOX_SHELL', busybox.full_path())
   configdata_priv.set('HAVE_EMBEDDED_SANDBOX_SHELL', 0)
+else
+  configdata_priv.set('HAVE_EMBEDDED_SANDBOX_SHELL', 0)
 endif
 
 fs = import('fs')
