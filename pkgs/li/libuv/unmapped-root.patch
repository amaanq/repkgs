Inside a user namespace that leaves uid and gid 0 unmapped, chown and setuid
to 0 fail with EINVAL instead of EPERM.

--- a/test/test-fs.c
+++ b/test/test-fs.c
@@ -342,7 +342,7 @@
      */
     ASSERT(req->result == 0 || req->result == UV_EPERM);
 #   else
-    ASSERT_EQ(req->result, UV_EPERM);
+    ASSERT(req->result == UV_EPERM || req->result == UV_EINVAL);
 #   endif
 #endif
   chown_cb_count++;
