--- a/test/ctest-tests.cmake.in
+++ b/test/ctest-tests.cmake.in
@@ -0,0 +1,21 @@
+set(port 10000)
+foreach(runner uv_run_tests uv_run_tests_a)
+  execute_process(COMMAND @CMAKE_CURRENT_BINARY_DIR@/${runner} --list
+                  OUTPUT_VARIABLE listing
+                  COMMAND_ERROR_IS_FATAL ANY)
+  string(REGEX MATCHALL "(^|\n)[a-z0-9_]+" names "${listing}")
+
+  foreach(name IN LISTS names)
+    string(STRIP "${name}" name)
+    set(dir @CMAKE_CURRENT_BINARY_DIR@/uv_tests/${runner}/${name})
+    file(MAKE_DIRECTORY ${dir})
+    file(CREATE_LINK @CMAKE_CURRENT_SOURCE_DIR@/test ${dir}/test SYMBOLIC)
+
+    add_test(${runner}/${name} @CMAKE_CURRENT_BINARY_DIR@/${runner} ${name})
+    set_tests_properties(${runner}/${name} PROPERTIES
+                         SKIP_RETURN_CODE 7
+                         WORKING_DIRECTORY ${dir}
+                         ENVIRONMENT UV_TEST_PORT=${port})
+    math(EXPR port "${port} + 3")
+  endforeach()
+endforeach()
