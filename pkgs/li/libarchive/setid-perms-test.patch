+static int
+setid_allowed(void)
+{
+	int fd = open("setid_probe", O_WRONLY | O_CREAT, 0700);
+	int allowed = fd >= 0 && fchmod(fd, S_ISUID | S_ISGID | 0700) == 0;
+
+	if (fd >= 0)
+		close(fd);
+	unlink("setid_probe");
+	return allowed;
+}
