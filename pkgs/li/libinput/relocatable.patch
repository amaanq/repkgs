-config_h.set_quoted('LIBINPUT_QUIRKS_DIR', dir_data)
-config_h.set_quoted('LIBINPUT_QUIRKS_OVERRIDE_FILE', libinput_data_override_path)
+config_h.set('LIBINPUT_QUIRKS_DIR',
+	      'RELOC("@0@")'.format(import('fs').relative_to(dir_data, dir_lib)))
+config_h.set('LIBINPUT_TOOL_QUIRKS_DIR',
+	      'RELOC("@0@")'.format(import('fs').relative_to(dir_data, dir_libexec)))
+config_h.set_quoted('LIBINPUT_QUIRKS_OVERRIDE_FILE', '/etc/libinput/local-overrides.quirks')
 
 config_h.set_quoted('LIBINPUT_QUIRKS_SRCDIR', dir_src_quirks)
 install_subdir('quirks',
@@ -411,8 +414,8 @@
