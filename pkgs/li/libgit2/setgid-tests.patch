+bool cl_is_setgid_supported(void)
+{
+	static int _is_supported = -1;
+
+	if (_is_supported < 0) {
+		cl_must_pass(p_mkdir("setgid.t", 0777));
+		_is_supported = p_chmod("setgid.t", 02777) == 0;
+		cl_must_pass(p_rmdir("setgid.t"));
+	}
+
+	return _is_supported;
+}
