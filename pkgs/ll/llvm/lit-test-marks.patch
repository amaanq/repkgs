@@ -62,8 +62,24 @@
     return _parallelism_semaphores.get(pg, NopSemaphore())
 
 
+def _announce(test):
+    marks = os.environ.get("BIGTOP_TEST_MARKS")
+    if not marks:
+        return
+    spelled = test.getFullName().encode().hex()
+    parts = [spelled[at : at + 128] for at in range(0, len(spelled), 128)]
+    path = os.path.join(marks, *parts)
+    if len(path) >= 4096:
+        raise ValueError("test name too long to announce: " + test.getFullName())
+    try:
+        os.close(os.open(path, os.O_RDONLY))
+    except FileNotFoundError:
+        pass
+
+
 # Do not inline! Directly used by LitTestCase.py
 def _execute(test, lit_config):
+    _announce(test)
