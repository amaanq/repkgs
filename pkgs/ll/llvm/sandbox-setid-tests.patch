diff -ruN a/llvm/test/lit.cfg.py b/llvm/test/lit.cfg.py
--- a/llvm/test/lit.cfg.py
+++ b/llvm/test/lit.cfg.py
@@ -48,6 +48,21 @@
 # directories.
 config.excludes = ["Inputs", "CMakeLists.txt", "README.txt", "LICENSE.txt"]
 
+
+def setid_chmod_allowed():
+    import tempfile
+
+    with tempfile.NamedTemporaryFile() as probe:
+        try:
+            os.chmod(probe.name, 0o6640)
+        except PermissionError:
+            return False
+    return True
+
+
+if setid_chmod_allowed():
+    config.available_features.add("setid-chmod")
+
 if config.enable_profcheck:
     config.available_features.add("profcheck")
     # Exclude llvm-reduce tests for profcheck because we substitute the FileCheck
