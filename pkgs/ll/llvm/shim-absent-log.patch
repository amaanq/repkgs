+namespace {
+/// Appends every path a lookup finds missing to $SHIM_ABSENT_LOG, one per
+/// line. shim keys cached compiles on them, so a header that later appears
+/// earlier on the search path invalidates the entry.
+class AbsentPathLogger
+    : public llvm::RTTIExtends<AbsentPathLogger, llvm::vfs::ProxyFileSystem> {
+  std::unique_ptr<llvm::raw_fd_ostream> Log;
+
+  void noteMissing(const llvm::Twine &Path, std::error_code EC) {
+    if (Log && EC == llvm::errc::no_such_file_or_directory)
+      *Log << (Path + "\n").str();
+  }
+
+public:
+  inline static const char ID = 0;
+
+  AbsentPathLogger(IntrusiveRefCntPtr<llvm::vfs::FileSystem> FS,
+                   StringRef LogPath)
+      : RTTIExtends(std::move(FS)) {
+    std::error_code EC;
+    Log = std::make_unique<llvm::raw_fd_ostream>(LogPath, EC,
+                                                 llvm::sys::fs::OF_Append);
+    if (EC)
+      Log.reset();
+    else
+      Log->SetUnbuffered();
+  }
+
+  llvm::ErrorOr<llvm::vfs::Status> status(const llvm::Twine &Path) override {
+    auto Result = ProxyFileSystem::status(Path);
+    if (!Result)
+      noteMissing(Path, Result.getError());
+    return Result;
+  }
+
+  llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>>
+  openFileForRead(const llvm::Twine &Path) override {
+    auto Result = ProxyFileSystem::openFileForRead(Path);
+    if (!Result)
+      noteMissing(Path, Result.getError());
+    return Result;
+  }
+};
+} // namespace
+
 IntrusiveRefCntPtr<llvm::vfs::FileSystem>
 clang::createVFSFromCompilerInvocation(const CompilerInvocation &CI,
                                        DiagnosticsEngine &Diags) {
@@ -5506,6 +5552,8 @@
 clang::createVFSFromCompilerInvocation(
     const CompilerInvocation &CI, DiagnosticsEngine &Diags,
     IntrusiveRefCntPtr<llvm::vfs::FileSystem> BaseFS) {
+  if (const char *Log = ::getenv("SHIM_ABSENT_LOG"); Log && *Log)
+    BaseFS = llvm::makeIntrusiveRefCnt<AbsentPathLogger>(std::move(BaseFS), Log);
   return createVFSFromOverlayFiles(CI.getHeaderSearchOpts().VFSOverlayFiles,
                                    Diags, std::move(BaseFS));
 }
