diff -ruN a/src/loadlib.c b/src/loadlib.c
--- a/src/loadlib.c
+++ b/src/loadlib.c
@@ -55,7 +55,16 @@
 #define LIB_FAIL	"open"
 
 
+#if defined(LUA_DL_DLL)
 #define setprogdir(L)           ((void)0)
+#else
+#include "reloc.h"
+
+static void setprogdir (lua_State *L) {
+  luaL_gsub(L, lua_tostring(L, -1), LUA_EXEC_DIR, RELOC("."));
+  lua_remove(L, -2);
+}
+#endif
 
 
