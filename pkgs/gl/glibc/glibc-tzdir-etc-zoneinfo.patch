--- a/time/tzfile.c
+++ b/time/tzfile.c
@@ -146,12 +146,21 @@
   if (*file != '/')
     {
       const char *tzdir;
+      const char *name = file;
 
       tzdir = getenv ("TZDIR");
       if (tzdir == NULL || *tzdir == '\0')
 	tzdir = default_tzdir;
-      if (__asprintf (&new, "%s/%s", tzdir, file) == -1)
+      if (__asprintf (&new, "%s/%s", tzdir, name) == -1)
 	goto ret_free_transitions;
+      /* NixOS has no /usr/share and keeps the database in /etc/zoneinfo */
+      if (tzdir == default_tzdir && __access (new, F_OK) != 0)
+	{
+	  free (new);
+	  new = NULL;
+	  if (__asprintf (&new, "/etc/zoneinfo/%s", name) == -1)
+	    goto ret_free_transitions;
+	}
       file = new;
     }
 
