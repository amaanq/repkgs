+#ifndef _LIBC_PREFIX_H
+#define _LIBC_PREFIX_H 1
+
+/* PATH with the prefix glibc was configured for replaced by the one libc.so
+   is installed under now, kept in *CACHE once known.  A static program
+   cannot know where it was copied and gets /dev/null instead.  */
+extern const char *__libc_prefix_path (const char *path, const char **cache)
+  attribute_hidden;
+
+#define LIBC_PREFIX_PATH(path)						      \
+  ({ static const char *libc_prefix_cache;				      \
+     __libc_prefix_path ((path), &libc_prefix_cache); })
+
+#endif /* libc-prefix.h */
--- /dev/null
+++ b/misc/libc-prefix.c
@@ -0,0 +1,88 @@
+/* Rewriting configured data paths for the prefix libc.so runs from.  */
+
+#include <atomic.h>
+#include <dlfcn.h>
+#include <ldsodefs.h>
+#include <libc-prefix.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define NO_PREFIX "/dev/null"
+
+/* Two directories above the libc.so holding this function, as a malloc'd
+   string of *LEN bytes, or NULL in a static program.  */
+static char *
+runtime_prefix (size_t *len)
+{
+#ifdef SHARED
+  Dl_info info;
+  struct link_map *map;
+  const ElfW(Sym) *symbol;
+  if (_dl_addr (runtime_prefix, &info, &map, &symbol) == 0
+      || info.dli_fname == NULL)
+    return NULL;
+
+  size_t end = strlen (info.dli_fname);
+  for (int level = 0; level < 2;)
+    {
+      size_t stop = end;
+      while (end > 0 && info.dli_fname[end - 1] != '/')
+	--end;
+      if (end == 0)
+	return NULL;
+      /* dli_fname keeps the RUNPATH spelling, which may be DIR/. */
+      if (stop - end != 1 || info.dli_fname[end] != '.')
+	++level;
+      --end;
+    }
+
+  char *prefix = malloc (end + 1);
+  if (prefix == NULL)
+    return NULL;
+  *((char *) __mempcpy (prefix, info.dli_fname, end)) = '\0';
+  *len = end;
+  return prefix;
+#else
+  return NULL;
+#endif
+}
+
+const char *
+__libc_prefix_path (const char *path, const char **cache)
+{
+  const char *known = atomic_load_acquire (cache);
+  if (known != NULL)
+    return known;
+
+  size_t configured = strlen (PREFIX);
+  const char *rewritten = path;
+  char *fresh = NULL;
+  if (strncmp (path, PREFIX, configured) == 0
+      && (path[configured] == '/' || path[configured] == '\0'))
+    {
+      size_t len;
+      char *prefix = runtime_prefix (&len);
+      if (prefix == NULL)
+	rewritten = NO_PREFIX;
+      else
+	{
+	  const char *rest = path + configured;
+	  fresh = malloc (len + strlen (rest) + 1);
+	  if (fresh != NULL)
+	    strcpy (__mempcpy (fresh, prefix, len), rest);
+	  free (prefix);
+	  if (fresh == NULL)
+	    return path;
+	  rewritten = fresh;
+	}
+    }
+
+  const char *expected = NULL;
+  while (!atomic_compare_exchange_weak_release (cache, &expected, rewritten))
+    if (expected != NULL)
+      {
+	free (fresh);
+	return expected;
+      }
+  return rewritten;
+}
