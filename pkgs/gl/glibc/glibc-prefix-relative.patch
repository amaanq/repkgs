+/* The canonical directory ld.so was loaded from, with a trailing slash,
+   or NULL.  The libraries of its closure sit beside it wherever the
+   closure was copied, so it replaces the configured system directories.
+   This runs before rtld copies the PT_INTERP name into l_name.  */
+static char *
+closure_libdir (size_t *len)
+{
+#ifdef SHARED
+  const char *name = _dl_rtld_map.l_name;
+  if (name == NULL && _dl_rtld_map.l_libname != NULL)
+    name = _dl_rtld_map.l_libname->name;
+  if (name == NULL || name[0] == '\0')
+    return NULL;
+  char *joined = NULL;
+  if (name[0] != '/')
+    {
+      /* crt-interp resolves a relative PT_INTERP against the executable's
+	 directory, not the working directory.  */
+      int self = __open64_nocancel ("/proc/self/exe", O_RDONLY | O_CLOEXEC);
+      if (self < 0)
+	return NULL;
+      char *program = _dl_canonicalize (self);
+      __close_nocancel (self);
+      if (program == NULL)
+	return NULL;
+      size_t dir = strlen (program);
+      while (dir > 0 && program[dir - 1] != '/')
+	--dir;
+      joined = malloc (dir + strlen (name) + 1);
+      if (joined == NULL)
+	{
+	  free (program);
+	  return NULL;
+	}
+      strcpy (__mempcpy (joined, program, dir), name);
+      free (program);
+      name = joined;
+    }
+  int fd = __open64_nocancel (name, O_RDONLY | O_CLOEXEC);
+  free (joined);
+  if (fd < 0)
+    return NULL;
+  char *path = _dl_canonicalize (fd);
+  __close_nocancel (fd);
+  if (path == NULL)
+    return NULL;
+  size_t end = strlen (path);
+  while (end > 0 && path[end - 1] != '/')
+    --end;
+  if (end == 0)
+    {
+      free (path);
+      return NULL;
+    }
+  path[end] = '\0';
+  *len = end;
+  return path;
+#else
+  return NULL;
+#endif
+}
