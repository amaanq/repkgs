+++ b/src/util/xmlconfig.c
@@ -28,6 +28,7 @@
  */
 
 #include "xmlconfig.h"
+#include "reloc.h"
 #include <ctype.h>
 #include <limits.h>
 #include <stdarg.h>
@@ -1372,7 +1373,7 @@
          free(dir);
       }
    } else {
