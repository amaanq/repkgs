+fn binary_object<C: ElfClass>(
+    architecture: Architecture,
+    path: &Path,
+    contents: &[u8],
+) -> Result<Vec<u8>> {
+    const SECTION_NAMES: &[u8] = b"\0.data\0.symtab\0.strtab\0.shstrtab\0";
+
+    let mangled = path
+        .as_os_str()
+        .as_encoded_bytes()
+        .iter()
+        .map(|&byte| {
+            if byte.is_ascii_alphanumeric() {
+                byte
+            } else {
+                b'_'
+            }
+        })
+        .collect_vec();
+    let mut names = vec![0];
+    let mut name_offsets = [0; 3];
+    for (offset, suffix) in name_offsets.iter_mut().zip(["_start", "_end", "_size"]) {
+        *offset = u32::try_from(names.len())?;
+        names.extend_from_slice(b"_binary_");
+        names.extend_from_slice(&mangled);
+        names.extend_from_slice(suffix.as_bytes());
+        names.push(0);
+    }
+
+    let header_size = usize::from(C::FILE_HEADER_SIZE);
+    let symbol_size = C::SYMTAB_ENTRY_SIZE as usize;
+    let section_header_size = usize::from(C::SECTION_HEADER_SIZE);
+    let symbols_offset = (header_size + contents.len()).next_multiple_of(8);
+    let names_offset = symbols_offset + 4 * symbol_size;
+    let section_names_offset = names_offset + names.len();
+    let sections_offset = (section_names_offset + SECTION_NAMES.len()).next_multiple_of(8);
+    let mut out = vec![0; sections_offset + 5 * section_header_size];
+
+    let header = object::from_bytes_mut::<FileHeader<C>>(&mut out)
+        .map_err(|()| error!("Invalid binary object header"))?
+        .0;
+    let ident = header.ident_mut();
+    ident.magic = object::elf::ELFMAG;
+    ident.class = FileHeader::<C>::CLASS;
+    ident.data = object::elf::ELFDATA2LSB;
+    ident.version = object::elf::EV_CURRENT;
+    header.set_type(object::elf::ET_REL);
+    header.set_machine(architecture.elf_machine()?);
+    header.set_version(object::elf::EV_CURRENT.0.into());
+    header.set_section_header_offset(sections_offset as u64)?;
+    header.set_header_size(C::FILE_HEADER_SIZE);
+    header.set_section_header_entry_size(C::SECTION_HEADER_SIZE);
+    header.set_section_header_count(5);
+    header.set_section_name_table_index(object::elf::SymbolSection(4));
+
+    out[header_size..header_size + contents.len()].copy_from_slice(contents);
+    out[names_offset..section_names_offset].copy_from_slice(&names);
+    out[section_names_offset..section_names_offset + SECTION_NAMES.len()]
+        .copy_from_slice(SECTION_NAMES);
+
+    let symbols = slice_from_all_bytes_mut::<SymtabEntry<C>>(
+        &mut out[symbols_offset..symbols_offset + 4 * symbol_size],
+    );
+    let values = [
+        (object::elf::SymbolSection(1), 0),
+        (object::elf::SymbolSection(1), contents.len() as u64),
+        (object::elf::SHN_ABS, contents.len() as u64),
+    ];
+    for ((symbol, name), (section, value)) in symbols[1..].iter_mut().zip(name_offsets).zip(values)
+    {
+        symbol.set_name(name);
+        symbol.set_binding_and_type(object::elf::STB_GLOBAL, object::elf::STT_OBJECT);
+        symbol.set_section(section);
+        symbol.set_value(value)?;
+    }
+
+    let sections = slice_from_all_bytes_mut::<SectionHeader<C>>(&mut out[sections_offset..]);
+    let layout = [
+        (1, sht::PROGBITS, header_size, contents.len(), 8),
+        (7, sht::SYMTAB, symbols_offset, 4 * symbol_size, 8),
+        (15, sht::STRTAB, names_offset, names.len(), 1),
+        (
+            23,
+            sht::STRTAB,
+            section_names_offset,
+            SECTION_NAMES.len(),
+            1,
+        ),
+    ];
+    for (section, (name, kind, offset, size, alignment)) in sections[1..].iter_mut().zip(layout) {
+        section.set_name(name);
+        section.set_type(kind);
+        section.set_offset(offset as u64)?;
+        section.set_size(size as u64)?;
+        section.set_alignment(alignment)?;
+    }
+    sections[1].set_flags(shf::ALLOC | shf::WRITE)?;
+    sections[2].set_link(3);
+    sections[2].set_info(1);
+    sections[2].set_entry_size(symbol_size as u64)?;
+
+    Ok(out)
+}
