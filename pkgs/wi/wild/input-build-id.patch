+            | secnames::GROUP_SECTION_NAME
+            | secnames::NOTE_GNU_BUILD_ID_SECTION_NAME => {
                 return SectionRuleOutcome::Discard;
             }
             secnames::RISCV_ATTRIBUTES_SECTION_NAME => return SectionRuleOutcome::RiscVAttribute,
