+fn write_package_note<C: ElfClass>(buffer: &mut [u8], metadata: &[u8]) -> Result {
+    buffer.fill(0);
+    let (note_header, mut rest) = from_bytes_mut::<elf::NoteHeader<C>>(buffer)
+        .map_err(|_| insufficient_allocation(NOTE_PACKAGE_SECTION_NAME_STR))?;
+    note_header.set_name_size(FDO_NOTE_NAME.len() as u32);
+    note_header.set_descriptor_size(metadata.len() as u32 + 1);
+    note_header.set_type(NT_FDO_PACKAGING_METADATA);
+
+    let name_out = rest.split_off_mut(..FDO_NOTE_NAME.len()).unwrap();
+    name_out.copy_from_slice(FDO_NOTE_NAME);
+
+    rest.get_mut(..metadata.len())
+        .ok_or_else(|| insufficient_allocation(NOTE_PACKAGE_SECTION_NAME_STR))?
+        .copy_from_slice(metadata);
+
+    Ok(())
+}
