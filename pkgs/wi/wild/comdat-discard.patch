         Ok(section.data(LittleEndian, self.data)?)
     }
 
+    fn discarded_comdat_sections(
+        &self,
+        is_lost: impl Fn(object::SymbolIndex) -> bool,
+    ) -> Result<Vec<bool>> {
+        let mut discarded = Vec::new();
+
+        for section in self.sections.iter() {
+            let Some((flags, members)) = section.group(LittleEndian, self.data)? else {
+                continue;
+            };
+
+            if !flags.contains(object::elf::GRP_COMDAT) {
+                continue;
+            }
+
+            let signature = object::SymbolIndex(section.sh_info(LittleEndian) as usize);
+            let symbol = self.symbols.symbol(signature)?;
+
+            if symbol.is_local() || symbol.is_undefined() || !is_lost(signature) {
+                continue;
+            }
+
+            discarded.resize(self.sections.len(), false);
+
+            for member in members {
+                let index = member.get(LittleEndian) as usize;
+                let Some(slot) = discarded.get_mut(index) else {
+                    bail!("COMDAT group member section index {index} is out of range");
+                };
+                *slot = true;
+            }
+        }
+
+        Ok(discarded)
+    }
