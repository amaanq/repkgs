--- /dev/null
+++ b/wild/tests/sources/elf/hidden-symtab-local/hidden-symtab-local.c
@@ -0,0 +1,13 @@
+//#LinkArgs:-shared -z now
+//#RunEnabled:false
+//#CompArgs:-fPIC
+//#DiffEnabled:false
+//#ExpectSym:hidden_fn binding=local
+//#ExpectSym:hidden_data binding=local
+//#ExpectSym:public_fn binding=global
+
+__attribute__((visibility("hidden"))) int hidden_fn(int x) { return x + 1; }
+
+__attribute__((visibility("hidden"))) int hidden_data;
+
+int public_fn(int x) { return hidden_fn(x) + hidden_data; }
