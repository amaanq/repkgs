+fn raise_note_alignments_to_contents<'data, P: Platform>(
+    group_states: &[GroupState<'data, P>],
+    output_sections: &mut OutputSections<P>,
+) {
+    let mut raised = Vec::new();
+    for group_state in group_states {
+        let sizes = &group_state.common.mem_sizes;
+        for raw in crate::part_id::regular_part_base::<P>().as_usize()..sizes.num_parts() {
+            let part_id = PartId::from_usize(raw);
+            if *sizes.get(part_id) != 0 {
+                raised.push((
+                    part_id.output_section_id::<P>(),
+                    part_id.alignment(output_sections),
+                ));
+            }
+        }
+    }
+    for (section_id, alignment) in raised {
+        let splits_segment = P::program_segment_defs().iter().any(|def| {
+            def.splits_on_alignment_change()
+                && output_sections.should_include_in_segment(section_id, *def)
+        });
+        if splits_segment {
+            output_sections.bump_min_alignment(section_id, alignment);
+        }
+    }
+}
