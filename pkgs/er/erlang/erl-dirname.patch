diff -ruN a/erts/etc/unix/erl.src.src b/erts/etc/unix/erl.src.src
--- a/erts/etc/unix/erl.src.src
+++ b/erts/etc/unix/erl.src.src
@@ -22,7 +22,10 @@
 #
 
 absolute_parent() {
-    DIR=$(dirname "${1}");
+    case "${1}" in
+        */*) DIR="${1%/*}"; DIR="${DIR:-/}" ;;
+        *) DIR=. ;;
+    esac
     (cd "$DIR" && pwd -P || echo "/");
 }
 
@@ -37,14 +40,18 @@
     then
         # It is likely that the files have been copied or moved
         echo "$CANDIDATE";
-    else
+    elif [ -n "${2}" ]
+    then
         echo "${2}";
+    else
+        echo "${0##*/}: cannot find erts-%VSN% above ${1}, set ERL_ROOTDIR" >&2;
+        exit 1;
     fi
 }
 
 if [ -z "$ERL_ROOTDIR" ]
 then
-    ROOTDIR=$(find_rootdir "$0" "%FINAL_ROOTDIR%")
+    ROOTDIR=$(find_rootdir "$0" "%FINAL_ROOTDIR%") || exit 1
 else
     ROOTDIR="$ERL_ROOTDIR"
 fi
