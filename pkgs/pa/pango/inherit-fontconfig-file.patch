The suite pins FONTCONFIG_FILE to the host's /etc/fonts/fonts.conf, which a sandbox
lacks, so the tests take the configuration the test step provides.

--- a/tests/meson.build
+++ b/tests/meson.build
@@ -17,7 +17,6 @@
 test_env.set('G_TEST_SRCDIR', meson.current_source_dir())
 test_env.set('G_TEST_BUILDDIR', meson.current_build_dir())
 test_env.set('LC_ALL', 'en_US.UTF-8')
-test_env.set('FONTCONFIG_FILE', '/etc/fonts/fonts.conf')
 
 tests = [
   [ 'test-coverage' ],
