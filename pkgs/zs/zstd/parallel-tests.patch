 # fuzzer
@@ -73,7 +74,20 @@
 target_link_libraries(fuzzer libzstd_static)
 AddTestFlagsOption(ZSTD_FUZZER_FLAGS "$ENV{FUZZERTEST} $ENV{FUZZER_FLAGS}"
     "Semicolon-separated list of flags to pass to the fuzzer test (see `fuzzer -h` for usage)")
-add_test(NAME fuzzer COMMAND "$<TARGET_FILE:fuzzer>" ${ZSTD_FUZZER_FLAGS})
+set(FUZZ_SEED ${CMAKE_CURRENT_BINARY_DIR}/fuzz-seed)
+add_test(NAME fuzz-seed COMMAND sh -c "echo $(( $(od -An -N2 -tu2 /dev/urandom) % 10000 )) > '${FUZZ_SEED}'")
+set_property(TEST fuzz-seed PROPERTY FIXTURES_SETUP fuzz-seed)
+function(AddSlicedTest name target count slice)
+    string(REPLACE ";" " " flags "${ARGN}")
+    foreach(first RANGE 1 ${count} ${slice})
+        math(EXPR last "${first} + ${slice} - 1")
+        add_test(NAME ${name}-${first} COMMAND sh -c "exec '$<TARGET_FILE:${target}>' -s$(cat '${FUZZ_SEED}') -t${first} -i${last} ${flags}")
+        set_property(TEST ${name}-${first} PROPERTY FIXTURES_REQUIRED fuzz-seed)
+        set_property(TEST ${name}-${first} APPEND PROPERTY LABELS Medium)
+    endforeach()
+endfunction()
+add_test(NAME fuzzer-unit COMMAND "$<TARGET_FILE:fuzzer>" -t0 -i0 ${ZSTD_FUZZER_FLAGS})
+AddSlicedTest(fuzzer fuzzer 30000 1000 ${ZSTD_FUZZER_FLAGS})
 # Disable the timeout since the run time is too long for the default timeout of
