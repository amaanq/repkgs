--- a/Config/installfns.sh
+++ b/Config/installfns.sh
@@ -2,6 +2,15 @@
 
 fndir=$DESTDIR$fndir
 scriptdir=$DESTDIR$scriptdir
+runhelpdir=$DESTDIR$runhelpdir
+
+relpath() {
+  from=$1 to=$2 up=
+  while test "${to#"$from"/}" = "$to"; do
+    from=${from%/*} up=../$up
+  done
+  echo "$up${to#"$from"/}"
+}
 
 /bin/sh $sdir_top/mkinstalldirs $fndir || exit 1;
 
@@ -49,7 +58,7 @@
