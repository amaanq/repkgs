{
  "Cargo.lock" = ''
    # This file is automatically @generated by Cargo.
    # It is not intended for manual editing.
    version = 4

    [[package]]
    name = "test-cargo"
    version = "0.1.0"
  '';
  "Cargo.toml" = ''
    [package]
    name    = "test-cargo"
    version = "0.1.0"
    edition = "2021"

    # a stripping release profile like many crates ship, which the builder's cargo settings override
    [profile.release]
    strip = true
  '';
  "src/main.rs" = ''
    fn main() {
        println!("test-cargo {}", env!("CARGO_PKG_VERSION"));
    }
  '';
}
